# Configurações do ambiente Docker
COMPOSE_PROJECT_NAME=distributed-cpp-system

# Portas dos serviços
MASTER_PORT=8080
SLAVE_LETTERS_PORT=8081
SLAVE_NUMBERS_PORT=8082

# URLs internas dos serviços
SLAVE1_URL=http://slave-letters:8081
SLAVE2_URL=http://slave-numbers:8082

# Configurações de rede
NETWORK_NAME=distributed-network

# Configurações de build
BUILD_CONTEXT=.
DOCKERFILE_MASTER=Dockerfile.master
DOCKERFILE_SLAVE1=Dockerfile.slave1
DOCKERFILE_SLAVE2=Dockerfile.slave2

# Configurações de container
RESTART_POLICY=unless-stopped

# Configurações de log
LOG_DRIVER=json-file
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3